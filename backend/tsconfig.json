{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "../",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "**/*.ts",
    "compiler/**/*.ts",
    "parser/**/*.ts",
    "scanner/**/*.ts",
    "errors/**/*.ts",
    "systemPrint/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
